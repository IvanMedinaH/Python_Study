# break - sale del bucle completamente
for i in range(10):
    if i == 5:
        break  # Sale cuando i es 5
    print(i)
# Imprime: 0, 1, 2, 3, 4

# continue - salta a la siguiente iteración
for i in range(5):
    if i == 2:
        continue  # Salta cuando i es 2
    print(i)
# Imprime: 0, 1, 3, 4